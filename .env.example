PORT=8443
HOST=127.0.0.1
JWT_SECRET=
JWT_EXPIRES_IN=7d
ALLOW_REGISTRATION=true
DB_PATH=./data/data.db
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
TZ=Asia/Shanghai
